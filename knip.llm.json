{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/test/*.ts"],
      "project": ["scripts/test/*.ts"]
    },
    "packages/std": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": ["host/fyd.ts", "tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/*": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/*": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "src/index.ts", "tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/index.ts", "src/main.tsx", "tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "includeEntryExports": true
}
