{
  // THE TYPE CHECKER'S VIEW OF THE ROOT PROJECT: `tsconfig.json` plus the declaration-only mapping of `durian-markdown`.
  //
  // WHY NOT IN `tsconfig.json`. Bun reads `tsconfig.json` `paths` at RUNTIME, and Bun 1.3.13 follows an entry to a `.d.ts` file: a unit
  // test, a scene build and the Chromium security gate then import the declaration (no `parse`, no `Blocks`) instead of the package, and
  // fail before their first assertion (Bun 1.4.4 skips declaration targets, which hid it). A mapping that only the type checker should
  // see lives where only the type checker looks: `scripts/validate/typecheck.sh` and the projects that extend this file. Nothing here
  // changes what is included, excluded or enforced; `paths` replaces the root's wholesale, so `playwright-core` is repeated.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "playwright-core": ["./packages/app/node_modules/playwright-core"],
      // `durian-markdown` is read as source and this workspace's compiler rejects that source (see the first file): the type
      // checker reads the declarations of the subset we use instead; the bundler still builds the real package.
      "durian-markdown": ["./packages/plugins/conversation/app/hypermedia/types/durian-markdown.d.ts"],
      "durian-markdown/react/strict": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/document": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/terminal": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/filetree": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/editor": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/codewalk": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/animation": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/tierlist": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/alignment": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      "durian-markdown/react/containers": [
        "./packages/plugins/conversation/app/hypermedia/types/durian-markdown-react.d.ts"
      ],
      // The stylesheet is generated by the Vite build (no `dist/`): everywhere else (a unit test) the import is this empty file.
      "durian-markdown/styles.css": ["./packages/plugins/conversation/app/hypermedia/types/durian-markdown-styles.css"]
    }
  }
}
