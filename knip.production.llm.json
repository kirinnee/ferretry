{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/std": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**", "!testing/**"]
    },
    "packages/core/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "src/index.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/index.ts", "src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "includeEntryExports": true
}
