[Unit]
Description=Ferretry loopback firewall: reject other users on each user's fixed browser ports
Documentation=https://github.com/kirinnee/ferretry
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ferretry-loopback-firewall apply
ExecStop=/usr/local/sbin/ferretry-loopback-firewall stop

[Install]
WantedBy=multi-user.target
