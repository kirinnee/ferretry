{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"],
    // The plugins' browser tests (tests/integration/app) import playwright-core, which only the app package installs: resolve it
    // to that one copy, so the root project can check them without a second dependency.
    // The `durian-markdown` declarations are NOT mapped here: this file is what Bun reads at runtime, and Bun 1.3.13 follows
    // a `paths` entry to a declaration file and hands a test or a scene build `undefined` for every name. They are in
    // `tsconfig.typecheck.json`, the one the type checker is pointed at. The stylesheet IS mapped, because it is a stand-in and not a
    // declaration: the package ships no `dist/`, and every test that imports `durian-markdown/styles.css` needs this empty file at runtime.
    "paths": {
      "playwright-core": ["./packages/app/node_modules/playwright-core"],
      "durian-markdown/styles.css": ["./packages/plugins/conversation/app/hypermedia/types/durian-markdown-styles.css"]
    }
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": ["packages/app", "**/node_modules"]
}
