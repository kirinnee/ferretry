{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"]
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": [
    "packages/app",
    "**/node_modules",
    // pending app port: agenda separate app port in flight
    "packages/plugins/agenda/app",
    // pending app port: agenda app-shell-fill React runtime and app test harness
    "packages/plugins/agenda/tests/unit/app",
    // pending app port: agenda app-shell-fill React runtime and app test harness
    "packages/plugins/agenda/tests/support/app",
    // Agenda browser fixtures await app-shell-fill; preserve the port's integration-test exclusion.
    "packages/plugins/agenda/tests/integration/app",
    // pending app port: browsers separate app port in flight
    "packages/plugins/browsers/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/tests/unit/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/tests/support/app",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page
    "packages/plugins/runtimes/app/components/runtime-buttons.tsx",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page
    "packages/plugins/runtimes/app/hooks/use-account-picker.ts",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page
    "packages/plugins/runtimes/app/lib/account-picker-store.ts",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page
    "packages/plugins/runtimes/app/lib/account-picker-catalog.ts",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page
    "packages/plugins/runtimes/app/lib/account-health-view.ts",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page; AccountUsageRow is a hand copy of Usage's UsageAccountView and must read Usage's contract when mounted
    "packages/plugins/runtimes/app/lib/daemon-picker-model.ts",
    // pending app port: runtimes no mount point until Ferrets' new-ferret page; a hand copy of Usage's quota-readout, it must read Usage's contract when mounted
    "packages/plugins/runtimes/app/components/quota-readout.tsx"
  ]
}
