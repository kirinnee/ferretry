{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"]
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": [
    "packages/app",
    "**/node_modules",
    // Agenda browser fixtures await app-shell-fill; preserve the port's integration-test exclusion.
    "packages/plugins/agenda/tests/integration/app",
    // Conversation's fy-render browser tests need playwright-core, the Vite harness and the built sandbox shell, which the
    // test tier has not got; they are never run locally (app/NEEDS-APP-SHELL.txt).
    "packages/plugins/conversation/tests/integration/app",
    "packages/plugins/conversation/tests/realworld/app",
    // Claude Code's card screenshots (the same browser harness): they need playwright-core, which only the app package has.
    "packages/plugins/claude-code/tests/integration/app"
  ]
}
