{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"],
    // The plugins' browser tests (tests/integration/app) import playwright-core, which only the app package installs: resolve it
    // to that one copy, so the root project can check them without a second dependency.
    "paths": { "playwright-core": ["./packages/app/node_modules/playwright-core"] }
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": ["packages/app", "**/node_modules"]
}
