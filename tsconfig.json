{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"]
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": [
    "packages/app",
    "**/node_modules",
    // pending app port: agenda separate app port in flight
    "packages/plugins/agenda/app",
    // pending app port: agenda app-shell-fill React runtime and app test harness
    "packages/plugins/agenda/tests/unit/app",
    // pending app port: agenda app-shell-fill React runtime and app test harness
    "packages/plugins/agenda/tests/support/app",
    // Agenda browser fixtures await app-shell-fill; preserve the port's integration-test exclusion.
    "packages/plugins/agenda/tests/integration/app",
    // pending app port: browsers separate app port in flight
    "packages/plugins/browsers/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/tests/unit/app",
    // pending app port: terminals shell daemon-client, grants and browser-link facilities
    "packages/plugins/terminals/tests/support/app",
    // pending app port: packs the chat's reference-proved Markdown, PeerName, MessageFooter and ToolGroup, and Conversation's transcript row hosting the card
    "packages/plugins/packs/app/components/pack-call.tsx",
    // pending app port: packs the chat's reference-proved Markdown, PeerName, MessageFooter and ToolGroup, and Conversation's transcript row hosting the card
    "packages/plugins/packs/tests/unit/app/pack-call.test.tsx"
  ]
}
