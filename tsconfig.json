{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@ferretry/relay/adapters": ["./packages/relay/src/adapters/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  "include": ["packages/*/bin", "packages/*/src", "packages/*/tests", "scripts/validate", "scripts/local"],
  "exclude": ["packages/pwa"]
}
