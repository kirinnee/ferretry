{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "types": ["bun"]
  },
  "include": [
    "packages/std",
    "packages/core/*/**/*",
    "packages/plugins/*/**/*",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/tests"
  ],
  "exclude": [
    "packages/app",
    "**/node_modules",
    "packages/plugins/*/app/**/*.tsx",
    "packages/plugins/*/tests/**/*.tsx",
    "packages/plugins/runtimes/app/hooks",
    "packages/plugins/onboarding/app/landing-geometry.ts",
    "packages/plugins/onboarding/app/setup-qr.ts",
    "packages/plugins/onboarding/tests/unit/app/get-started-script.test.ts",
    "packages/plugins/onboarding/tests/unit/app/setup-qr.test.ts",
    "packages/plugins/terminals/app",
    "packages/plugins/terminals/tests/unit/app",
    "packages/plugins/terminals/tests/support/app"
  ]
}
