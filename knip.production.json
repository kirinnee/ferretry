{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/cli": {
      "entry": ["bin/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["bin/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"]
    },
    "packages/fleet": {
      "entry": ["src/lib/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["src/lib/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/pwa": {
      "entry": ["src/lib/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off"
  }
}
