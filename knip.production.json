{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/std": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**", "!testing/**"]
    },
    "packages/core/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"],
      "ignore": ["src/lib/tool-client.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/core/ferrets": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/agenda": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"],
      "ignore": [
        "app/components/agenda-message.tsx",
        "app/hooks/use-agenda-deep-link.ts",
        "app/hooks/use-agenda-replies.ts",
        "app/hooks/use-agenda.ts",
        "app/hooks/use-answered-suggestion-sweep.ts",
        "app/hooks/use-notification-open.ts",
        "app/hooks/use-notifications.ts",
        "app/lib/agenda-chat.ts",
        "app/lib/agenda-deep-link.ts",
        "app/lib/answer-chip.ts",
        "app/lib/item-conversation.ts",
        "app/lib/notification-ledger.ts",
        "app/lib/notification-open.ts",
        "app/lib/notification-preferences.ts",
        "app/lib/notification-tap.ts",
        "app/lib/notify.ts",
        "app/lib/permission-request.ts",
        "app/lib/push-delivery.ts",
        "app/features/permission-request/approval-card.tsx",
        "app/features/agenda/agenda-inbox-composer.tsx",
        "app/features/agenda/agenda-line.tsx",
        "app/features/agenda/agenda-nav.tsx",
        "app/features/agenda/agenda-replies-notice.tsx",
        "app/features/agenda/agenda.tsx",
        "app/lib/agenda-source-refs.ts"
      ]
    },
    "packages/plugins/board": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/claude-code": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/packs": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/projects": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/runtimes": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/updates": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/warden": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/connections": {
      "entry": ["worker/src/adapters/worker.ts"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/catalogs": {
      "entry": ["worker/src/adapters/link-store-worker.ts"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/conversation": {
      "entry": ["app/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"],
      "ignore": [
        "app/search/session-search.tsx",
        "app/composer/composer-references.ts",
        "app/render/fy-render-workspace-media.ts",
        "app/render/workspace-path.ts",
        "daemon/questions/lib/answer-wording.ts",
        "daemon/questions/lib/coordinator.ts",
        "daemon/questions/lib/projection.ts",
        "daemon/questions/lib/rendered-form.ts",
        "daemon/questions/lib/service.ts",
        "daemon/reader/lib/session/conversation-index.ts",
        "daemon/reader/lib/session/reader.ts",
        "daemon/reader/lib/session/tail-cache.ts",
        "daemon/reader/lib/session/log-page.ts",
        "app/chat/message-marks-legend.tsx",
        "daemon/attachments/adapters/raw-deflate.ts"
      ]
    }
  },
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off",
    "dependencies": "warn"
  },
  "tags": ["-pending"]
}
