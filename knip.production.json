  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off",
    "dependencies": "warn"
  },
  "tags": ["-pending"]
}
