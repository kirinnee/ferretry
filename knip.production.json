{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/std": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**", "!testing/**"]
    },
    "packages/core/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/*": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "src/index.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"],
      "ignore": ["src/lib/tool-client.ts"]
    },
    "packages/app": {
      "entry": ["src/index.ts", "src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off",
    "dependencies": "warn"
  }
}
