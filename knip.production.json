{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/std": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**", "!testing/**"]
    },
    "packages/core/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/*": {
      "entry": [],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"],
      "ignore": ["src/lib/tool-client.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/core/ferrets": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/agenda": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/board": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/claude-code": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/packs": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/projects": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/runtimes": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/updates": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/warden": {
      "entry": ["app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/connections": {
      "entry": ["worker/src/adapters/worker.ts"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/catalogs": {
      "entry": ["worker/src/adapters/link-store-worker.ts"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/conversation": {
      "entry": ["app/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/mcp": {
      "entry": ["app/views/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    },
    "packages/plugins/skills": {
      "entry": ["app/views/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}", "!tests/**"]
    }
  },
  "bun": false,
  "github-actions": false,
  "node": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off",
    "dependencies": "warn"
  },
  "tags": ["-pending"]
}
