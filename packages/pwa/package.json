{
  "name": "@ferretry/pwa",
  "version": "0.0.0",
  "private": true,
  "description": "Installable multi-daemon browser application",
  "type": "module",
  "compositionRoots": [
    "src/main.tsx",
    "src/worker/service-worker.ts",
    "src/worker/parakeet-worker.ts",
    "src/worker/sherpa-worker.ts",
    "src/worker/vosk-worker.ts",
    "src/worker/whisper-worker.ts"
  ],
  "scripts": {
    "dev": "bun run build:fy-render-shell && vite",
    "build": "bun run build:fy-render-shell && vite build && bun run scripts/build-model-catalog.ts && bun run scripts/build-release.ts",
    "build:fy-render-shell": "bun run scripts/build-fy-render-libs.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ferretry/fleet": "workspace:*",
    "@ferretry/protocol": "workspace:*",
    "@ferretry/relay": "workspace:*",
    "@huggingface/transformers": "4.3.1",
    "@lichess-org/vosk-browser": "0.0.3",
    "@sherpaw/asr": "0.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "4.6.1",
    "chartjs-plugin-zoom": "2.2.0",
    "dompurify": "3.4.13",
    "highlight.js": "^11.11.1",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.24.1",
    "parakeet.js": "1.4.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "lottie-web": "5.13.0",
    "mermaid": "11.16.1",
    "playwright-core": "^1.55.0",
    "postcss": "^8.4.49",
    "react-test-renderer": "^19.0.0",
    "should": "^13.2.3",
    "tailwindcss": "^3.4.16",
    "vite": "^8.2.0"
  }
}
