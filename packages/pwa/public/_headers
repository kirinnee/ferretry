  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# The `fy-render` sandbox shell. Its CONTENT policy travels in the document as a
# `<meta http-equiv>`, which is enforced independently inside the opaque frame and
# keeps the script hashes in the same generated file as the scripts they pin. This
# rule carries only the two things a meta tag cannot express.
#
# The `!` line is load-bearing. Without it Cloudflare appends this policy to the
# `/*` one, and `/*` carries `frame-ancestors 'none'` — which would make the shell
# unframeable and the whole feature inert. `/*` itself is deliberately untouched.
#
# `sandbox allow-scripts` re-applies the opaque origin at the response level, so
# navigating straight to this URL yields an inert document rather than a live one.
#
# TWO PATHS, AND THE SECOND ONE IS THE ONE THAT IS SERVED. Pages' pretty URLs answer
# `/fy-render-sandbox.html` with a 308 to `/fy-render-sandbox`, and `_headers` matches the
# path that is REQUESTED. With only the `.html` rule, the redirect wore this policy and the
# document itself wore `/*`'s `frame-ancestors 'none'`: the frame was refused, the shell
# never announced itself, and every Mermaid and html block in production read "The
# illustration sandbox did not start". `scripts/validate/pages-config.sh` pins both, and
# `tests/e2e/fy-render-pages.e2e.test.ts` proves it under `wrangler pages dev`.
/fy-render-sandbox.html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self'; sandbox allow-scripts
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

/fy-render-sandbox
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self'; sandbox allow-scripts
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# The `fy-render` html shell, where an `html` block WITH script runs (one without stays a static
# fragment in the page). The same two lines as the library shell above, for the same reasons: its
# content policy is a meta tag inside the document (it runs author code, so it carries
# `script-src 'unsafe-inline'` and nothing that reaches the network), the `!` line keeps `/*`'s
# `frame-ancestors 'none'` off it, and `sandbox allow-scripts` makes a direct visit opaque. Both the
# `.html` path and the extensionless one Pages' pretty URLs redirect it to, as above.
/fy-render-html.html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self'; sandbox allow-scripts
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

/fy-render-html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self'; sandbox allow-scripts
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# The two trusted library bundles the PARENT fetches and transfers over the
# capability port; the frame never requests them itself.
#
# `no-cache` means revalidate, NOT "do not store": the bytes are reused across
# visits but a deploy can never be pinned behind a stale copy. These filenames are
# fixed rather than content-addressed, so they must not be marked immutable — an
# immutable stale bundle would fail the shell's hash pin and disable the feature
# until the cache expired, with no way to push a fix.
/fy-render-mermaid.js
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

/fy-render-lottie.js
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.*
  Cache-Control: no-cache, no-store, must-revalidate

/manifest*.webmanifest
  Cache-Control: no-cache

/offline.*
  Cache-Control: no-cache

# The MCP sign-in callback page arrives with an authorization code in its address, so neither it nor
# its script is stored: no disk copy, and no back-forward cache entry holding the code.
/oauth/*
  Cache-Control: no-store

# A share link's code rides in the address fragment of this page, so the document is never stored
# either: no disk copy and no back-forward cache entry for a page that was handed a live code.
/join
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
