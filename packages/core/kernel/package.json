{
  "name": "@ferretry/kernel",
  "version": "5.0.0",
  "private": true,
  "description": "The core host and the plugin SDK: the contract leaf, the manifest SDK, the test host and the daemon host",
  "type": "module",
  "bin": {
    "fyd": "host/fyd.ts"
  },
  "ferretry": {
    "id": "kernel",
    "manifest": "./plugin.ts"
  },
  "exports": {
