{
  // Deployment configuration for YOUR OWN link store: the Worker that holds the sealed envelopes of
  // the catalog links your daemons share. It serves exactly the fingerprints you list, in the
  // Cloudflare account you pay for. Ferretry's separately operated deployment is
  // `wrangler.link-store.hosted.json`; its switches and limits never change this configuration.
  //
  //   1. put your daemon fingerprint in `vars.LINK_STORE_DAEMON_IDS` below (`fy pair` prints it)
  //   2. `task link-store:check`, then `task link-store:deploy`
  //
  // See docs/cloudflare-relay-self-hosting.md — "Your own link store" — for what you are taking on.
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "ferretry-link-store",
  "main": "src/adapters/link-store-worker.ts",
  "compatibility_date": "2026-07-01",

  // The fingerprints this deployment stores links for, separated by spaces or commas. A fingerprint
  // is public — it is printed in the pairing QR — so this is configuration and not a secret. Leaving
  // it empty serves nobody, which is the only safe reading of a store whose operator never said who
  // it is for. Anyone holding a link's fetch token can still read that link: the list limits who
  // may UPLOAD, not who may open.
  "vars": {
    "LINK_STORE_MODE": "self-hosted",
    "LINK_STORE_DAEMON_IDS": "",
  },

  "durable_objects": {
    "bindings": [
      { "name": "LINK_BUNDLE", "class_name": "LinkBundleDurableObject" },
      { "name": "LINK_OWNER", "class_name": "LinkOwnerDurableObject" },
      { "name": "LINK_STORE_CONTROL", "class_name": "LinkStoreControlDurableObject" },
    ],
  },

  // SQLite-backed Durable Objects are the class the free plan allows.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LinkBundleDurableObject", "LinkOwnerDurableObject", "LinkStoreControlDurableObject"],
    },
  ],

  "observability": { "enabled": true },
}
