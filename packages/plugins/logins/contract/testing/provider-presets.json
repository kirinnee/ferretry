          "required": true,
          "allowEmpty": false,
          "harnesses": ["claude-code"]
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "kind": "secret",
          "secret": "ZAI_API_KEY",
          "required": true,
          "allowEmpty": false,
          "harnesses": ["claude-code"]
        },
        {
          "name": "API_TIMEOUT_MS",
          "kind": "plain",
          "value": "3000000",
          "required": false,
          "allowEmpty": false,
          "harnesses": ["claude-code"]
        }
      ],
      "models": [],
      "test": {
        "available": true,
        "spends": "nothing",
