{
  "presets": [
    {
      "id": "anthropic-api-key",
      "label": "Anthropic API key",
      "harness": "claude-code",
      "summary": "Claude Code with an API key from the Claude Platform console, billed per token.",
      "docs": "https://code.claude.com/docs/en/model-config",
      "group": "popular",
      "origin": "built-in",
      "variables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "kind": "secret",
          "secret": "ANTHROPIC_API_KEY",
          "required": true,
          "allowEmpty": false,
          "description": "the API key, sent as x-api-key",
          "harnesses": ["claude-code"]
        }
      ],
      "models": [],
      "test": {
        "available": true,
        "spends": "nothing",
        "note": "Lists the models the key can use. Spends nothing."
      },
      "quota": {
        "source": "transcript-pricing",
        "note": "An API key has no usage endpoint of its own, so cost is counted from the transcript at Anthropic's prices."
      },
      "unverified": [],
      "verified": "2026-10-16",
      "offered": {
        "available": true
      },
      "halves": [
        {
          "harness": "claude-code",
          "offered": {
            "available": true
          },
          "models": []
        }
      ],
      "detect": {
        "hosts": ["api.anthropic.com"],
        "variables": [],
        "keyPrefixes": ["sk-ant-api"]
      }
    },
    {
      "id": "amazon-bedrock",
      "label": "Amazon Bedrock (AWS profile)",
      "harness": "claude-code",
      "summary": "Claude Code through Amazon Bedrock, using an AWS profile from ~/.aws on this machine. The profile is named, never copied.",
      "docs": "https://code.claude.com/docs/en/amazon-bedrock",
      "group": "cloud",
      "origin": "built-in",
      "variables": [
        {
          "name": "CLAUDE_CODE_USE_BEDROCK",
          "kind": "plain",
          "value": "1",
          "required": true,
          "allowEmpty": false,
          "harnesses": ["claude-code"]
        },
        {
          "name": "AWS_REGION",
          "kind": "plain",
          "value": "us-east-1",
          "required": true,
          "allowEmpty": false,
          "description": "the region Bedrock is called in",
          "harnesses": ["claude-code"]
        }
      ],
      "cloudCredential": {
        "kinds": ["aws-profile"],
        "suggested": "aws-profile:default"
      },
      "models": [],
      "test": {
        "available": false,
        "reason": "Bedrock needs AWS request signing, which Ferretry does not do. Check the profile with `aws sts get-caller-identity --profile <name>`."
      },
      "quota": {
        "source": "transcript-pricing",
        "note": "AWS Service Quotas reports limits, not what is used, so cost is counted from the transcript at Bedrock's prices."
      },
      "unverified": [
        "No free read proves Bedrock invoke rights; ListInferenceProfiles proves the profile signs in, not that it may run a model."
      ],
      "verified": "2026-10-16",
      "offered": {
        "available": true
      },
      "halves": [
        {
          "harness": "claude-code",
          "offered": {
            "available": true
          },
          "models": []
        }
      ],
      "detect": {
        "hosts": [],
        "variables": ["CLAUDE_CODE_USE_BEDROCK", "AWS_PROFILE"],
        "keyPrefixes": []
      }
    },
