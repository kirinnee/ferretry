        {
          "harness": "codex",
          "offered": {
            "available": false,
            "reason": "Z.ai serves the Responses API, but Codex only runs GLM with a model catalogue file (model_catalog_json) and this preset has no verified Codex model list yet. Use this login with Claude Code instead."
