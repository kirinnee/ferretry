{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/bin/**/*.ts",
      "packages/*/src/**/*.{ts,tsx}",
      "packages/*/tests/**/*.{ts,tsx}",
      "packages/*/harness/**/*.{ts,tsx}"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
