{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/test/*.ts"],
      "project": ["scripts/test/*.ts"]
    },
    "packages/std": {
      "project": ["**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/*": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/*": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx", "src/worker/service-worker.ts", "scripts/**/*.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,css}"]
    },
    "packages/core/gate": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/ferrets": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": [
        "daemon/lib/session/auto-resume/**",
        "daemon/adapters/session/auto-resume/**",
        "daemon/lib/session/events/service.ts",
        "daemon/lib/session/peers/reads.ts",
        "daemon/lib/session/observer/facts.ts",
        "daemon/lib/session/observer/observer.ts",
        "daemon/lib/session/observer/plan.ts",
        "daemon/lib/session/observer/protocol.ts",
        "daemon/lib/session/observer/restart.ts",
        "daemon/adapters/session/observer/index.ts",
        "daemon/adapters/session/observer/session-worker-runtime.ts",
        "daemon/adapters/session/observer/worker-observer-host.ts",
        "daemon/adapters/session/observer/worker-supervisor.ts",
        "daemon/workers/session-index.worker.ts",
        "daemon/lib/session/peers/turn.ts",
        "daemon/lib/session/peers/transcript.ts",
        "daemon/lib/session/peers/question.ts",
        "daemon/lib/session/peers/send.ts",
        "daemon/lib/session/restart/index.ts",
        "daemon/lib/session/live/index.ts",
        "daemon/adapters/session/archive/index.ts",
        "daemon/lib/session/directory/session-directory.ts",
        "daemon/lib/session/monitor/types.ts",
        "daemon/lib/session/runtime-control/index.ts",
        "daemon/lib/session/runtime-control/service.ts",
        "daemon/adapters/session/launch/index.ts"
      ]
    },
    "packages/plugins/agenda": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx", "tests/**/fixtures/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["app/lib/agenda-source-refs.ts"]
    },
    "packages/plugins/board": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["app/lib/card-reference-context.ts", "app/lib/lane-proposal-link.ts"]
    },
    "packages/plugins/claude-code": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/packs": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/projects": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/runtimes": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/updates": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/warden": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/connections": {
      "entry": ["tests/**/*.test.{ts,tsx}", "worker/src/adapters/worker.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/catalogs": {
      "entry": ["tests/**/*.test.{ts,tsx}", "worker/src/adapters/link-store-worker.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/conversation": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/fixtures/**/*.{ts,tsx}", "app/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/usage": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/fixtures/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/voice": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/realworld/dev/**/*.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["daemon/lib/speedups/index.ts"]
    },
    "packages/plugins/access": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["app/features/pairing/device-refused-notice.tsx", "app/lib/device-preference.ts"]
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "enumMembers": "off"
  },
  "ignoreIssues": {
    "packages/plugins/shells/contract/wire.ts": ["duplicates"]
  },
  "tags": ["-pending"]
}
