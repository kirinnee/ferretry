{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/test/*.ts"],
      "project": ["scripts/test/*.ts"]
    },
    "packages/std": {
      "project": ["**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/*": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/*": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx", "src/worker/service-worker.ts", "scripts/**/*.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,css}"]
    },
    "packages/core/gate": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/ferrets": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/agenda": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx", "tests/**/fixtures/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": [
        "app/features/settings/notification-machines.tsx",
        "app/lib/machine-notifications.ts",
        "app/lib/agenda-source-refs.ts"
      ]
    },
    "packages/plugins/board": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/claude-code": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/packs": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/projects": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/runtimes": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/updates": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/warden": {
      "entry": ["tests/**/*.test.{ts,tsx}", "app/views/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/connections": {
      "entry": ["tests/**/*.test.{ts,tsx}", "worker/src/adapters/worker.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/catalogs": {
      "entry": ["tests/**/*.test.{ts,tsx}", "worker/src/adapters/link-store-worker.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/conversation": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/fixtures/**/*.{ts,tsx}", "app/surfaces.tsx"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["app/composer/use-composer-preferences.ts"]
    },
    "packages/plugins/usage": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/fixtures/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/voice": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/realworld/dev/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "enumMembers": "off"
  },
  "ignoreIssues": {
    "packages/plugins/shells/contract/wire.ts": ["duplicates"]
  },
  "tags": ["-pending"]
}
