{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/cli": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
    },
    "packages/fleet": {
      "entry": ["src/lib/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["src/lib/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/pwa": {
      "entry": ["src/lib/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "enumMembers": "off"
  }
}
