{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/test/*.ts"],
      "project": ["scripts/test/*.ts"]
    },
    "packages/std": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/core/kernel": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/core/*": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/plugins/*": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/types/*.types.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "src/index.ts", "tests/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx", "src/worker/service-worker.ts", "scripts/*.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "enumMembers": "off"
  },
  "ignoreIssues": {
    "packages/plugins/shells/contract/wire.ts": ["duplicates"]
  }
}
