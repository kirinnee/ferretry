{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/e2e/**/*.test.ts", "scripts/test/*.ts"],
      "project": ["tests/e2e/**/*.ts", "scripts/test/*.ts"]
    },
    "packages/cli": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["bin/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
    },
    "packages/fleet": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/relay": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/pwa": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "tests/**/*.test.{ts,tsx}",
        "harness/screenshot.ts",
        "harness/app-screenshot.ts",
        "harness/main.tsx",
        "harness/tasks-pane-benchmark.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "harness/**/*.{ts,tsx}", "vite.config.ts"]
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "enumMembers": "off"
  }
}
